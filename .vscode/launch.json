{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug",
            "type": "gdb",
            "request": "launch",
            "target": "./bin/korra",
            "cwd": "${workspaceRoot}",
            "valuesFormatting": "parseText",
            "arguments": "--log-level trace --config test/context/data/config/socket_A.json"
        },
        {
            "name": "Python Debugger: Python File",
            "type": "debugpy",
            "request": "launch",
            "program": "tool/test.py",
            "args": ["color_test"]
        }
    ]
}