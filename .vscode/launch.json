{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug",
            "type": "gdb",
            "request": "launch",
            "target": "./bin/mosaic_test",
            "cwd": "${workspaceRoot}",
            "valuesFormatting": "parseText",
            "arguments": ""
        },
        {
            "name": "Python Debugger: Python File",
            "type": "debugpy",
            "request": "launch",
            "program": "tool/test.py",
            "args": ["mosaic_test"]
        }
    ]
}