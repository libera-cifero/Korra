digraph {
    rankdir=BT;

    subgraph src{
        subgraph encoder{
            subgraph cluster_providers {
                label="providers";
                style=rounded;
                color=black;

                provider[
                    color=red;
                    fontcolor=red;
                ];
                mosaic_provider[
                    color=blue;
                    fontcolor=blue;
                ];

                subgraph mosaic {
                    bit_area [fontcolor=green; color = green;];
                    point [fontcolor=green; color = green;];
                    mosaic_math;
                    mosaic_settings [fontcolor=green; color = green;];
                    
                    mosaic_settings->mosaic_provider;
                    
                    point->mosaic_provider;

                    bit_area->mosaic_provider;

                    mosaic_math->mosaic_provider;
                    

                    
                    subgraph cluster_color_codecs{
                        label="color_codecs";
                        color_codec [
                            color=purple;
                            fontcolor=purple;
                        ];
                        hsv_codec [
                            color=blue;
                            fontcolor=blue;
                        ];
                        palette_codec[
                            color=purple;
                            fontcolor=purple;
                        ];
                        rgb_palette_codec[
                            color=blue;
                            fontcolor=blue;
                        ];
                        ycbcr_palette_codec[
                            color=blue;
                            fontcolor=blue;
                        ];
                        hsv_codec->color_codec [color=blue; ];
                        palette_codec->color_codec[color=purple;];   
                        rgb_palette_codec->palette_codec [color=blue;];
                        ycbcr_palette_codec->palette_codec [color=blue];
                    }
                    color_codec->mosaic_provider [minlen=2;];
                }

                mosaic_provider->provider[color = blue;];
            }
            subgraph cluster_compressors {
                label="compressors";
                style=rounded;
                color=black;
                compressor [
                    color=red;
                    fontcolor=red;
                ];
                none_compressor [
                    color=blue;
                    fontcolor=blue;
                ];
                none_compressor->compressor [color=blue];
            }

            subgraph cluster_obfuscators 
            {
                label="obfuscators";
                style=rounded;
                color=black;

                obfuscator[
                    color = red;
                    fontcolor=red;
                ];
                none_obfuscator [
                    color=blue;
                    fontcolor=blue;
                ];

                none_obfuscator->obfuscator [color=blue];
            }

            subgraph cluster_correctors{
                label="correctors";
                style=rounded;
                color=black;

                corrector[
                    color = red;
                    fontcolor=red;
                ];
                none_corrector [
                    color=blue;
                    fontcolor=blue;
                ];

                none_corrector->corrector [color=blue];
            }

            video_encoder [color=blue;fontcolor=blue;];
            color;
            status_error[color=blue; fontcolor=blue;];
            math;
            
            
            provider->video_encoder; 
            compressor->video_encoder;
            obfuscator->video_encoder;
            corrector->video_encoder;

            color->rgb_palette_codec;
            color->hsv_codec;
            
            status_error->color;
            status_error->color_codec;

        }
        subgraph video_pipes {
            label="video_pipes";
            video_pipe_in [color=red; fontcolor=red;];
            video_pipe_out [color = red; fontcolor=red;];
            ffmpeg_rtmp_pipe_in [color=blue;fontcolor=blue;];
            ffmpeg_rtmp_pipe_out [color=blue;fontcolor=blue;];

            video_pipe_config [color=green; fontcolor=green;];
            ffmpeg_rtmp_config [color=green;fontcolor=green;];

            ffmpeg_rtmp_config->video_pipe_config [color=green;];

            ffmpeg_rtmp_pipe_in->video_pipe_in [color=blue;];
            ffmpeg_rtmp_pipe_out->video_pipe_out [color=blue;];
            
            ffmpeg_rtmp_config->ffmpeg_rtmp_pipe_in;
            ffmpeg_rtmp_config->ffmpeg_rtmp_pipe_out;
        }

        video_socket [color=blue; fontcolor=blue;];
        
        video_encoder->video_socket [weight=2;];
        video_pipe_in->video_socket;
        video_pipe_out->video_socket;
    }

    subgraph cluster_test{
        style=rounded;
        label="TESTS";
        subgraph lib{
            test;
        }

        color_test;
        mosaic_provider_test;
        math_test;
        
        test->color_test;
        test->mosaic_provider_test;
        test->math_test;

        frame_io->mosaic_provider_test;
    }

    color->mosaic_provider_test;
    mosaic_settings->mosaic_provider_test;
    mosaic_provider->mosaic_provider_test [color=orange; minlen=10;];

    color->color_test [color=orange;];

    math->math_test [color=orange;];

}