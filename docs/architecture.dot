digraph {
    rankdir=BT;

    subgraph src{

        subgraph cluster_config{
            label="config";
            style=rounded;
            subgraph cluster_data {
                label="data";
                style=rounded;

                video_config [color=green; fontcolor=green;];
                mosaic_config [color=green; fontcolor=green;];
                block_codec_config [color=green; fontcolor=green;];
                palette_codec_config [color=green; fontcolor=green;];
                cipher_config [color = green; fontcolor=green;]

                mosaic_config->video_config [color=green;];
                cipher_config -> video_config [color = green;];
                block_codec_config->mosaic_config [color=green;];
                palette_codec_config->block_codec_config [color=green;];
            }
            subgraph cluster_parser{
                label="parsers";
                style=rounded;

                subgraph cluster_base{
                    label="";
                    color=none;
                    json_parser [color=red;fontcolor=red;];
                    specific_parser[color=red; fontcolor=red;];
                    abstract_parser [color = purple; fontcolor=purple;];
                    contexted_in[color=blue; fontcolor=blue;];
                    contexted_out [color=blue; fontcolor=blue;];

                    specific_parser->json_parser [color=red; ];
                    abstract_parser->json_parser [color=purple;]; 
                    specific_parser->abstract_parser;
                }

                subgraph cluster_children {
                    color=none;
                    label="";
                    subgraph cluster_frame_codec{
                    #    color=black;
                        #label="frame_codec"
                        frame_codec_parser [color=blue; fontcolor=blue;];
                        subgraph cluster_provider{
                        #    label="provider"
                            provider_parser [color = blue; fontcolor=blue; ];
                            subgraph cluster_mosaic{    
                        #        label="mosaic"
                                mosaic_provider_parser [color=blue; fontcolor=blue;];
                                subgraph cluster_block_codec{
                        #            label="block_codec"
                                    block_codec_parser [color=blue; fontcolor=blue;];
                                    rgb_palette_codec_parser [color=blue; fontcolor=blue;];
                                    block_codec_parser->abstract_parser;
                                    
                                    rgb_palette_codec_parser->specific_parser [color=blue; ];
                                    rgb_palette_codec_parser->block_codec_parser[color=none;];
                                }
                                block_codec_parser->mosaic_provider_parser;
                                specific_parser -> block_codec_parser;
                            }
                        }
                        subgraph cluster_cipher{
                           
                            cipher_parser [color = blue; fontcolor=blue; ];
                            none_cipher_parser [color=blue; fontcolor=blue;];
                        }
                    }
                }
                
                frame_codec_parser->json_parser [color=blue; minlen=2;];
                frame_codec_parser->contexted_in [color = blue; minlen=2;];

                cipher_parser->abstract_parser [color=blue;minlen=2;];
                cipher_parser->contexted_in [color=blue;minlen=2;];
                cipher_parser->frame_codec_parser;

                none_cipher_parser->specific_parser [color=blue; minlen=2;];
                none_cipher_parser->contexted_in [color=blue;minlen=2;];
                specific_parser->cipher_parser;
                none_cipher_parser->cipher_parser [color=none;];
                
                provider_parser->abstract_parser [color=blue;minlen=2;];
                provider_parser->contexted_in [color=blue;minlen=2;];
                provider_parser->frame_codec_parser;
                
                mosaic_provider_parser->specific_parser [color=blue;minlen=2;];
                specific_parser->provider_parser;
                mosaic_provider_parser->provider_parser [color=none;];
                mosaic_provider_parser->contexted_in [color=blue; minlen=2;];
                mosaic_provider_parser->contexted_out [color=blue;minlen=2;];
                mosaic_config->mosaic_provider_parser [minlen=2;];
                video_config->mosaic_provider_parser [minlen=2;];
                
                block_codec_parser->abstract_parser [color=blue;minlen=2;];
                block_codec_parser->contexted_in [color=blue;minlen=2;];
                block_codec_parser->contexted_out [color=blue;minlen=2;];
                block_codec_config->block_codec_parser [minlen=2;];
                mosaic_config->block_codec_parser [minlen=2;];
                video_config->block_codec_parser [minlen=2;];

               
                
                cipher_config->cipher_parser [minlen=2;];
                cipher_config->none_cipher_parser [minlen=2;];
                video_config->provider_parser [minlen=2;];
            }

        }

        subgraph cluster_data_boxers {
            label="data_boxers";
            style=rounded;
            subgraph data {
                identifiable [color=blue; fontcolor=blue;]

                korra_data [color=purple; fontcolor=purple;];
                begin_label_data [color=blue; fontcolor=blue;]
                piecable_data[color=purple; fontcolor=purple;];
                ip_data [color = blue; fontcolor=blue; ];
                pieced_data [color=blue; fontcolor=blue;]

                begin_label_data->korra_data [color=blue;];
                begin_label_data->identifiable [color = blue;];
                pieced_data->korra_data [color = blue;];
                pieced_data->identifiable [color=blue;];
                piecable_data->korra_data [color=purple;];
                ip_data->piecable_data [color=blue;];
            }
            subgraph data_boxer{
                data_boxer [color=blue; fontcolor=blue;];
                korra_data->data_boxer;
                
            }
            subgraph data_unboxer{

            }
        }
        subgraph cluster_video_codec {
            label="video_codec";
            style=rounded;
            subgraph frame_codec{
                subgraph cluster_providers {
                    label="providers";
                    style=rounded;
                    color=black;

                    provider[
                        color=red;
                        fontcolor=red;
                    ];
                    mosaic_provider[
                        color=blue;
                        fontcolor=blue;
                    ];

                    subgraph mosaic {
                        bit_area [fontcolor=green; color = green;];
                        point [fontcolor=green; color = green;];
                        mosaic_math;
                        mosaic_settings [fontcolor=green; color = green;];
                        
                        mosaic_settings->mosaic_config [color=green;];
                        mosaic_settings->mosaic_provider;
                        
                        point->mosaic_provider;

                        bit_area->mosaic_provider;

                        mosaic_math->mosaic_provider;
                        
                        subgraph cluster_block_codecs{
                            label="block_codecs";
                            block_codec [
                                color=purple;
                                fontcolor=purple;
                            ];
                            palette_codec[
                                color=purple;
                                fontcolor=purple;
                            ];
                            rgb_palette_codec[
                                color=blue;
                                fontcolor=blue;
                            ];
                            palette_codec->block_codec[color=purple;];   
                            rgb_palette_codec->palette_codec [color=blue;];
                            block_codec_config->block_codec;
                            palette_codec_config->palette_codec;
                            palette_codec_config->rgb_palette_codec;
                        }
                        block_codec->mosaic_provider [minlen=2;];
                    }

                    mosaic_provider->provider[color = blue;];
                }

                subgraph cluster_ciphers 
                {
                    label="ciphers";
                    style=rounded;
                    color=black;

                    cipher[
                        color = red;
                        fontcolor=red;
                    ];
                    none_cipher [
                        color=blue;
                        fontcolor=blue;
                    ];

                    none_cipher->cipher [color=blue];
                }
                frame_codec [color=blue;fontcolor=blue;];
                provider->frame_codec;
                cipher->frame_codec;
            }
            video_codec [color=blue;fontcolor=blue;];
            clock_generator[color=blue; fontcolor=blue;];
            sync_signals [color=blue; fontcolor=blue;];
            payload_storage [color=blue; fontcolor=blue;];
            clock_generator->video_codec;
            sync_signals->clock_generator;
            sync_signals->payload_storage;
            payload_storage->video_codec;
            frame_codec->payload_storage;
            frame_codec->video_codec;
        }

        subgraph cluster_video_pipes {
            label="video_pipes";
            style=rounded;

            video_pipe_in [color=red; fontcolor=red;];
            video_pipe_out [color = red; fontcolor=red;];
            ffmpeg_rtmp_pipe_in [color=blue;fontcolor=blue;];
            ffmpeg_rtmp_pipe_out [color=blue;fontcolor=blue;];

            ffmpeg_rtmp_settings [color=green;fontcolor=green;];

            ffmpeg_rtmp_pipe_in->video_pipe_in [color=blue;];
            ffmpeg_rtmp_pipe_out->video_pipe_out [color=blue;];
            
            ffmpeg_rtmp_settings->ffmpeg_rtmp_pipe_in;
            ffmpeg_rtmp_settings->ffmpeg_rtmp_pipe_out;

        }

        provider->mosaic_provider_parser [minlen = 15;];
        mosaic_provider->mosaic_provider_parser [minlen = 15;];
        ffmpeg_rtmp_settings->video_config [color=green; weight=0; ];

        video_socket [color=blue; fontcolor=blue;];
        
        video_codec->video_socket;
        video_pipe_in->video_socket;
        video_pipe_out->video_socket;

        payload_storage->data_boxer;
        data_boxer->video_socket;
        color->rgb_palette_codec;
    }

    subgraph cluster_test{
        style=rounded;
        label="TESTS";
        subgraph lib{
            test;
            time;
        }

        color_test;
        mosaic_provider_test;
        clock_generator_test;
        video_codec_test;
        
        test->color_test;
        test->mosaic_provider_test;
        test->clock_generator_test;
        test->video_codec_test;

        frame_io->mosaic_provider_test;
        frame_io->video_codec_test;

        time->clock_generator_test;
        time->mosaic_provider_test;
    }

    color;
    color->mosaic_provider_test;
    mosaic_settings->mosaic_provider_test;
    mosaic_provider->mosaic_provider_test [color=orange; minlen=10;];
    clock_generator->clock_generator_test [color = orange; minlen=10;];
    video_codec->video_codec_test [color = orange; minlen=10;];

    color->color_test [color=orange;];

}